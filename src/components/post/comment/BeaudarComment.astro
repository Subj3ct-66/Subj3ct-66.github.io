---
import { BEAUDAR } from "../../../utils/config";
---

<div id="comments" class="beaudar-comment" data-aos="fade-up"></div>

<script data-astro-rerun is:inline define:vars={{ BEAUDAR }}>
  let beaudarStarted = false;

  function setupBeaudar() {
    const container = document.querySelector(".beaudar-comment");
    if (!container) return;

    container.innerHTML = "";
    document.getElementById("beaudar-script")?.remove();

    let theme = BEAUDAR.theme || "github-light";
    let parsedTheme =
      theme === "auto"
        ? document.documentElement.getAttribute("data-theme") === "dark"
          ? "github-dark"
          : "github-light"
        : theme;

    if (parsedTheme !== "github-dark" && parsedTheme !== "github-light") {
      parsedTheme = "github-light";
    }

    window.loadScript(
      "https://beaudar.lipk.org/client.js",
      {
        id: "beaudar-script",
        repo: BEAUDAR.repo,
        ...(BEAUDAR.branch ? { branch: BEAUDAR.branch } : {}),
        "issue-term": BEAUDAR.issue_term || "pathname",
        theme: parsedTheme,
        crossorigin: "anonymous",
      },
      container
    );
  }

  const themeSetHandler = (e) => {
    let theme = e.detail.theme;
    if (e.detail.theme === "auto") {
      theme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    } else if (e.detail.theme === "eye-care") {
      theme = "light";
    }
    const iframe = document.querySelector("iframe.beaudar-frame");
    if (!iframe || !iframe.contentWindow) {
      document.body.removeEventListener("theme-set", themeSetHandler);
      return;
    }
    iframe.contentWindow.postMessage(
      { type: "set-theme", theme: `github-${theme}` },
      "https://beaudar.lipk.org"
    );
  };

  function startBeaudar() {
    if (beaudarStarted) return;
    beaudarStarted = true;

    document.body.removeEventListener("theme-set", themeSetHandler);
    document.body.addEventListener("theme-set", themeSetHandler);
    setupBeaudar();
  }

  function observeBeaudar() {
    const container = document.querySelector(".beaudar-comment");
    if (!container) return;

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            window.runWhenIdle(startBeaudar);
          }
        },
        { rootMargin: "200px 0px" }
      );
      observer.observe(container);
      return;
    }

    window.runWhenIdle(startBeaudar);
  }

  observeBeaudar();
  document.addEventListener("astro:page-load", () => {
    beaudarStarted = false;
    observeBeaudar();
  });
</script>

<style lang="stylus" is:global>
  .beaudar {
    max-width: none !important;
  }
</style>
