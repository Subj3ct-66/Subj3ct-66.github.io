---
import "../styles/global.css";
import "../styles/search.stylus";
import "../styles/music.stylus";
import "@reimujs/aos/dist/aos.css";

import { ClientRouter } from "astro:transitions";

import { BANNER, PLAYER, PLAYER_HAS_SOURCE, PRELOADER, SITE, SIDEBAR } from "../utils/config";
import { urlFor } from "../utils/urlFor";
import CommonMeta from "../components/partial/CommonMeta.astro";
import VendorScript from "../components/partial/VendorScript.astro";
import ThemeScript from "../components/partial/ThemeScript.astro";
import Header from "../components/Header.astro";
import AfterFooter from "../components/AfterFooter.astro";
import ToTop from "../components/partial/ToTop";
import Loader from "../components/partial/Loader.astro";
import Sidebar from "../components/Sidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import SidebarScript from "../components/sidebar/SidebarScript.astro";
import SearchBox from "../components/partial/SearchBox";
import MusicPlayer from "../components/partial/MusicPlayer";
import Firework from "../components/partial/Firework.astro";

type Props = {
  title?: string;
  description?: string;
  cover?: string;
  keywords?: string | string[];
  isPost?: boolean;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  toc?: boolean;
};

const {
  title = SITE.title,
  description = SITE.description,
  cover,
  keywords = SITE.keywords,
  isPost = false,
  headings = [],
  toc = true,
} = Astro.props;

const headerImage = cover || BANNER;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <ThemeScript />
    <CommonMeta title={title} description={description} keywords={keywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Zen+Kurenaido&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href={urlFor(headerImage)} />
    <style>
      main {
        position: relative;
        display: flex;
        padding-top: 8px;
        align-items: stretch;
        max-width: 1550px;
        margin: max(
            calc(var(--banner-area-height) * var(--content-overlap-ratio) * -1),
            calc(var(--banner-area-min-height) * var(--content-overlap-ratio) * -1)
          )
          auto 0;
        z-index: 1;
        overflow: visible;
      }

      @media screen and (max-width: 767px) {
        main {
          margin-top: max(
            calc(var(--banner-area-height) * 0.12 * -1),
            -96px
          );
        }
      }
    </style>
    <VendorScript />
    <ClientRouter />
  </head>
  <body>
    {PRELOADER.enable && <Loader />}
    <Header title={title} cover={cover}>
      <slot name="header" />
    </Header>

    <main
      class={SIDEBAR.position === "left"
        ? "sidebar-left"
        : SIDEBAR.position === "right"
          ? "sidebar-right"
          : ""}
    >
      {
        SIDEBAR.position === "left" && (
          <Sidebar isPost={isPost} headings={headings} toc={toc} />
        )
      }
      <slot />
      {
        SIDEBAR.position === "right" && (
          <Sidebar isPost={isPost} headings={headings} toc={toc} />
        )
      }
    </main>
    <slot name="footer" />
    <AfterFooter />
    <Firework />
    <ToTop client:load imageUrl={urlFor("images/OIP-nobg.webp")} />
    <MobileNav isPost={isPost} headings={headings} toc={toc} />
    <div id="mask" class="hide"></div>
    <SearchBox
      client:idle
      searchIndexUrl={urlFor("search.json")}
      postUrlPrefix={urlFor("blog")}
      imageUrl={urlFor("images/search-bg.webp")}
    />
    {
      PLAYER_HAS_SOURCE &&
        PLAYER.aplayer.options.fixed && (
          <MusicPlayer
            client:idle
            variant="fixed"
            useMeting={PLAYER.meting.enable}
            metingOptions={PLAYER.meting.options}
            metingApi={PLAYER.meting.meting_api}
            aplayerOptions={PLAYER.aplayer.options}
          />
        )
    }
    <SidebarScript />
  </body>
</html>
