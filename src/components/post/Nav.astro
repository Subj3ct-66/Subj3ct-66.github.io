---
import type { CollectionEntry } from "astro:content";

import { postCoverForEntry } from "../../utils/randomCover";
import { __ } from "../../utils/i18n";
import { BANNER } from "../../utils/config";
import { urlFor } from "../../utils/urlFor";

type Props = {
  prev: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
  navPrevCoverPosition?: string;
  navNextCoverPosition?: string;
};
const { prev, next, navPrevCoverPosition, navNextCoverPosition } = Astro.props;

const prevCover = prev
  ? urlFor((await postCoverForEntry(prev)) || BANNER)
  : "";
const nextCover = next
  ? urlFor((await postCoverForEntry(next)) || BANNER)
  : "";
---

{
  (prev || next) && (
    <nav id="article-nav" class="wow fadeInUp">
      {prev && (
        <div class="article-nav-link-wrap article-nav-link-left">
          <img
            loading="lazy"
            src={prevCover}
            alt={prev.data.title}
            style={
              navPrevCoverPosition || prev.data.coverPosition
                ? {
                    objectPosition:
                      navPrevCoverPosition ?? prev.data.coverPosition,
                  }
                : undefined
            }
          />
          <a href={urlFor(`blog/${prev.id}`)} aria-label="Previos Post" />
          <div class="article-nav-caption">{__("newer")}</div>
          <h3 class="article-nav-title">{prev.data.title || "(no title)"}</h3>
        </div>
      )}
      {next && (
        <div class="article-nav-link-wrap article-nav-link-right">
          <img
            loading="lazy"
            src={nextCover}
            alt={next.data.title}
            style={
              navNextCoverPosition || next.data.coverPosition
                ? {
                    objectPosition:
                      navNextCoverPosition ?? next.data.coverPosition,
                  }
                : undefined
            }
          />
          <a href={urlFor(`blog/${next.id}`)} aria-label="Next Post" />
          <div class="article-nav-caption">{__("older")}</div>
          <h3 class="article-nav-title">{next.data.title || "(no title)"}</h3>
        </div>
      )}
    </nav>
  )
}

<style lang="stylus">
  #article-nav {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    @media screen and (min-width: 768px) {
      flex-direction: row;
    }
  }

  .article-nav-link-wrap {
    color: #fff;
    position: relative;
    isolation: isolate;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 20px;
    opacity: 0.9;
    transition: opacity 0.3s;
    height: 150px;
    min-height: 150px;
    flex-shrink: 0;
    background: var(--grey-9, #2a2a2a);
    overflow: hidden;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.42);
      z-index: 1;
      pointer-events: none;
    }

    a {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 3;
    }

    img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: var(--post-cover-position, center top);
      filter: brightness(70%);
      z-index: 0;
    }

    .article-nav-caption,
    .article-nav-title {
      position: relative;
      z-index: 2;
    }

    &:hover {
      opacity: 1;
    }
  }

  .article-nav-link-right {
    align-items: flex-end;
  }

  .article-nav-caption {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: bold;
    text-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.7);
  }

  .article-nav-title {
    font-size: 20px;
    line-height: 1.2;
    margin-top: 16px;
    text-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.7);
    -webkit-line-clamp: 3;
    line-clamp: 3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
