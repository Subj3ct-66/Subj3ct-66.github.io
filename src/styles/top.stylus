.sidebar-top {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 50px;
  height: 50px;
  background-color: var(--color-wrap);
  border-radius: 50%;
  font-family: font-icon;
  box-shadow: 1px 2px 10px rgba(0, 0, 0, .2);
  z-index: 999;
  user-select: none;
  transition: opacity 1s;
  cursor: pointer;

  @media screen and (max-width: 767px) {
    bottom: calc(84px + env(safe-area-inset-bottom, 0px));
    right: calc(16px + env(safe-area-inset-right, 0px));
    width: 44px;
    height: 44px;
  }

  img {
    transition: .3s;
    animation: rotate-all 3s linear infinite;
    opacity: 1;
    object-fit: contain;
  }

  .arrow-up {
    position: absolute;
    left: 10px;
    top: 10px;
    transition: .3s;
    opacity: 0;
    width: 30px;
    height: 30px;
    color: var(--red-1);
    text-align: center;
  }

  &:hover {
    img {
      opacity: 0;
    }
    .arrow-up {
      opacity: 1;
    }
  }
}